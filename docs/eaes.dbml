// =============================================================================
// FOREIGN KEY RELATIONSHIPS
// =============================================================================

Ref: "admin_assignments"."approved_by" > "users"."id" [delete: set null]
Ref: "admin_assignments"."college_id" > "colleges"."id" [delete: set null]
Ref: "admin_assignments"."department_id" > "departments"."id" [delete: set null]
Ref: "admin_assignments"."organization_id" > "organizations"."id" [delete: set null]
Ref: "admin_assignments"."revoked_by" > "users"."id" [delete: set null]
