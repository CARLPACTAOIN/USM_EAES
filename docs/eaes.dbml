  indexes {
    ("event_day_session_id", "student_id") [name: "attendance_records_event_day_session_id_student_id_index"]
    ("event_participation_scope_id", "student_id") [name: "attendance_records_event_participation_scope_id_student_id_inde"]
    ("event_id", "event_day_id", "student_id") [unique, name: "eaes_attendance_legacy_day_identity_unique"]
    ("event_id", "student_id") [unique, name: "eaes_attendance_legacy_identity_unique"]
    ("event_id", "event_day_session_id", "student_id") [unique, name: "eaes_attendance_legacy_session_identity_unique"]
    ("event_id", "event_day_id", "student_id", "event_participation_scope_id") [unique, name: "eaes_attendance_scoped_day_identity_unique"]
    ("event_id", "student_id", "event_participation_scope_id") [unique, name: "eaes_attendance_scoped_legacy_day_identity_unique"]
    ("event_id", "event_day_session_id", "student_id", "event_participation_scope_id") [unique, name: "eaes_attendance_scoped_session_identity_unique"]
  }
}

