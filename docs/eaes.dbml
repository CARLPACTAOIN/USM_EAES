Project usm_eaes {
  database_type: 'PostgreSQL'
  Note: '''
    # USM Event Attendance & Evaluation System (EAES)
    University of Southern Mindanao — Capstone Database Specification
    - Multi-tenant hierarchy: University -> College -> Department -> Program
    - Proposal workflow & digital permit evidence
    - High-throughput QR code scan capture & offline attendance sync
    - Mandatory evaluation gate unlocking attendance validation
  '''
}

Table "admin_assignments" {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "role_name" varchar(255) [not null]
  "organization_id" uuid
  "college_id" uuid
  "academic_year" varchar(255) [not null]
  "term_start" date
  "term_end" date
  "position_title" varchar(255)
  "status" varchar(255) [not null, default: 'active']
  "is_primary_admin" boolean [not null, default: true]
  "approved_by" uuid
  "approved_at" timestamp
  "revoked_by" uuid
  "revoked_at" timestamp
  "revocation_reason" text
  "created_at" timestamp
  "updated_at" timestamp
  "department_id" uuid
  "school_year_id" uuid
  "source_type" varchar(255)
  "source_id" uuid

  Note: 'Permission-facing Authority Projections mapping users to roles within exact School Year, Department, College, or Organization scopes.'

  indexes {
    ("role_name", "academic_year") [unique, name: "admin_assignments_active_primary_unique"]
    ("source_type", "source_id") [unique, name: "admin_assignments_active_source_unique"]
    ("organization_id", "school_year_id", "status") [name: "admin_assignments_org_school_year_status_index"]
    ("role_name", "academic_year", "status") [name: "admin_assignments_role_name_academic_year_status_index"]
    ("source_type", "source_id") [name: "admin_assignments_source_index"]
    ("user_id", "status") [name: "admin_assignments_user_id_status_index"]
    ("user_id", "school_year_id", "status") [name: "admin_assignments_user_school_year_status_index"]
  }
}

Table "approval_trails" {
  "id" uuid [pk]
  "proposal_id" uuid [not null]
  "workflow_run_id" uuid [not null]
  "workflow_task_id" uuid [not null]
  "actor_id" uuid [not null]
  "decision" varchar(255) [not null]
  "remarks" text
  "reference_id" varchar(255) [not null]
  "previous_status" varchar(255) [not null]
  "resulting_status" varchar(255) [not null]
  "assigned_role" varchar(255)
  "assigned_scope" varchar(255)
  "decided_at" timestamp [not null]
  "metadata" json
  "created_at" timestamp
  "updated_at" timestamp

  Note: 'Append-only immutable audit trail recording every approval, rejection, comment, and endorsement action.'

  indexes {
    ("proposal_id", "decided_at") [name: "approval_trails_proposal_id_decided_at_index"]
    "reference_id" [unique, name: "approval_trails_reference_id_unique"]
    ("workflow_run_id", "decided_at") [name: "approval_trails_workflow_run_id_decided_at_index"]
    ("workflow_task_id", "decided_at") [name: "approval_trails_workflow_task_id_decided_at_index"]
  }
}

